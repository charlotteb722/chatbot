---
// Charlotte's photo, once settings.yaml has a headshot file name. Renders nothing until then.
import Photo from './Photo.astro';
import { getSite } from '../lib/site';
const s = await getSite();
---
{s.headshot && (
  <figure class="headshot">
    <Photo src={s.headshot} alt={`${s.name}, website developer and digital consultant`} ratio="1 / 1" sizes="(min-width: 760px) 340px, 220px" widths={[240, 480, 680]} />
  </figure>
)}
