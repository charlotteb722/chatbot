---
// Stand-in tiles for photos. Replace with <img> elements when real, licensed photos are available.
interface Props { items: { label: string; bg: string }[] }
const { items } = Astro.props;
---
<ul class="gallery" role="list" style="list-style:none;padding:0">
  {items.map((t) => <li class="tile" style={`background:${t.bg}`}><span>{t.label}</span></li>)}
</ul>
