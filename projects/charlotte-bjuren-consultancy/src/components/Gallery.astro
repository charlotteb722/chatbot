---
// Photo gallery. items: { src (photo file name), alt, caption?, size?: 'wide' | 'tall' }
import Photo from './Photo.astro';
interface Props { items: { src: string; alt: string; caption?: string; size?: 'wide' | 'tall' }[] }
const { items } = Astro.props;
---
<div class="photo-grid">
  {items.map((p) => (
    <figure class={p.size}>
      <Photo src={p.src} alt={p.alt} ratio={p.size === 'tall' ? undefined : p.size === 'wide' ? '2 / 1' : '1 / 1'} sizes="(min-width: 760px) 25vw, 50vw" widths={[360, 720, 1080]} />
      {p.caption && <figcaption>{p.caption}</figcaption>}
    </figure>
  ))}
</div>
