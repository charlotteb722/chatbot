---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import HillsArt from '../components/HillsArt.astro';
import Section from '../components/Section.astro';
import Steps from '../components/Steps.astro';
import PriceCards from '../components/PriceCards.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Testimonials from '../components/Testimonials.astro';
import Headshot from '../components/Headshot.astro';
import { getSite as getSiteForPhoto } from '../lib/site';
const hasPhoto = !!(await getSiteForPhoto()).headshot;
import { getSite } from '../lib/site';

const s = await getSite();
const packages = await getCollection('packages');
const faqs = (await getCollection('faqs')).filter((f) => f.data.home).map((f) => f.data);
const portfolio = await getCollection('portfolio');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${s.name} | ${s.descriptor}`,
  url: 'https://charlottebjuren.com/',
  description: 'Website design, website care, AI coaching and business automation for small businesses in Perthshire and across the UK.',
  areaServed: ['Crieff', 'Perthshire', 'United Kingdom'],
  address: { '@type': 'PostalAddress', addressLocality: 'Crieff', addressRegion: 'Perthshire', addressCountry: 'GB' },
  priceRange: 'From £395',
};
---
<MainLayout
  title="Websites, AI and automation for small businesses in Perthshire"
  description="Charlotte Bjuren builds websites for small businesses in Crieff, Perthshire and across the UK. You own everything, you know the running costs up front, and there are no long contracts."
  jsonLd={jsonLd}
>
  <Hero
    kicker="Crieff, Perthshire · Websites, AI and automation"
    title="Websites for small businesses, built around how you actually work"
    lead="I help sole traders and small businesses across Perthshire and the UK get a website that brings in enquiries, costs little to run and belongs entirely to you."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href="/contact/#book">Book a free 30-minute chat</a>
      <a class="btn btn-secondary" href="/websites/">See prices</a>
    </Fragment>
    <HillsArt slot="art" />
  </Hero>
  <div class="stripe" aria-hidden="true"></div>

  <Section id="problems" kicker="Sound familiar?" title="Most small business owners I speak to are stuck in one of these places">
    <div class="grid-4">
      <div class="card"><h3>No website, or one you're embarrassed by</h3><p class="muted">It was built years ago, it looks dated on a phone, and you're not sure who has the login.</p></div>
      <div class="card"><h3>Everything runs through Facebook</h3><p class="muted">Social media works, but you don't control it, and customers who search Google can't find you.</p></div>
      <div class="card"><h3>Paying for things you don't understand</h3><p class="muted">Hosting, SEO, plugins, a monthly fee. You'd just like to know what you're paying for and why.</p></div>
      <div class="card"><h3>Curious about AI, but short of time</h3><p class="muted">You've heard it could help with admin and replies. You'd like someone to show you, with your own work.</p></div>
    </div>
  </Section>

  <Section id="services" tone="surface" kicker="How I can help" title="Websites first, with practical help with technology afterwards">
    <div class="grid">
      <article class="card"><h3>Websites</h3><p class="muted">New websites and redesigns, with the words written with you and the Google basics set up properly. Fixed prices from £{packages.find((p) => p.id === 'essentials')?.data.price}.</p><a class="more" href="/websites/">Websites and pricing</a></article>
      <article class="card"><h3>Website care</h3><p class="muted">I keep your site working, up to date and accurate, and make small changes when you need them. From £29 a month, no minimum term.</p><a class="more" href="/websites/#care">Care plans</a></article>
      <article class="card"><h3>AI coaching and automation</h3><p class="muted">One-to-one help using AI for a real task in your business, and simple automations for the repetitive admin that eats your evenings.</p><a class="more" href="/ai-and-automation/">AI and automation</a></article>
    </div>
  </Section>

  <Section id="promises" kicker="What you can count on" title="Three things I promise every client">
    <div class="grid">
      <div class="card"><h3>You own everything</h3><p class="muted">Your domain, hosting and website files are in your name from day one. If you ever want to move, you take it all with you.</p></div>
      <div class="card"><h3>You know the costs up front</h3><p class="muted">A fixed quote before any work starts, and a plain list of what the website will cost to run each year. Usually that's just the domain name.</p></div>
      <div class="card"><h3>No long contracts</h3><p class="muted">Care plans are month to month. Stop whenever you like with 30 days' notice.</p></div>
    </div>
  </Section>

  <Section id="how" tone="surface" kicker="How it works" title="From first chat to a live website">
    <Steps items={[
      { title: 'A free chat', text: 'Thirty minutes, by video or in person around Crieff. You tell me about your business and customers, and I tell you honestly what would help.' },
      { title: 'A clear plan and a fixed price', text: 'You get a written quote saying what is included, what it costs, what it will cost to run, and when it will be ready.' },
      { title: 'Build, check and launch', text: 'I build it and you review it before anything goes live. Then I show you how to make simple changes yourself.' },
    ]} />
  </Section>

  <Section id="pricing" kicker="Pricing" title="Fixed prices, so you know where you stand" intro="Every website includes mobile-friendly design, an enquiry form, Google basics and accounts in your name.">
    <PriceCards items={packages} compact cta={{ href: '/contact/', label: 'Ask about this' }} />
    <p class="note" style="margin-top:1.5rem"><strong>Introductory offer:</strong> my first three website clients pay £299, £599 or £999, in return for letting me write up the project as a case study and asking for an honest review. <a href="/websites/#offer">How the offer works</a>.</p>
  </Section>

  <Section id="work" tone="surface" kicker="Portfolio" title="See what your website could look like" intro="These three demonstration websites are for fictional businesses. They show the kind of site I build for trades, coaches and cafés.">
    <div class="grid">
      {portfolio.map(({ id, data: p }) => (
        <article class="card">
          <div class="swatch-row" aria-hidden="true">{p.colours.map((c) => <span style={`background:${c}`}></span>)}</div>
          <span class="tag">Demonstration · {p.sector}</span>
          <h3>{p.name}</h3>
          <p class="muted">{p.summary}</p>
          <a class="more" href={`/portfolio/${id}/`}>About this project</a>
        </article>
      ))}
    </div>
  </Section>

  <Section id="about" kicker="About me" title="A business analyst who builds websites">
    <div class:list={[hasPhoto ? 'grid-2' : 'narrow']}>
      <div class="prose">
        <p>I'm Charlotte, and I work as a Business Analyst. Most of my working life is spent understanding how organisations actually run, then using data, automation and good design to make things easier for the people involved.</p>
        <p>I bring the same approach to small business websites. Before thinking about colours or fonts, I want to understand what you do, who your customers are and what you need them to do next. The website comes out of that.</p>
        <p><a href="/about/">More about me and how I work</a></p>
      </div>
      <Headshot />
    </div>
  </Section>

  <Testimonials />

  <Section id="faqs" tone="surface" kicker="Questions" title="Common questions" narrow>
    <FaqList items={faqs} />
    <p style="margin-top:1.5rem"><a href="/faqs/">All frequently asked questions</a></p>
  </Section>

  <CtaBand title="Not sure what you need?" text="That's what the free chat is for. Thirty minutes, no obligation, and you'll come away with a clearer idea either way.">
    <a class="btn btn-light" href="/contact/#book">Book a free chat</a>
    <a class="btn btn-secondary" style="color:var(--c-on-dark);border-color:var(--c-on-dark)" href="/contact/">Send a message</a>
  </CtaBand>
</MainLayout>
