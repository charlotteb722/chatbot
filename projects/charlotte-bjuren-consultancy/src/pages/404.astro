---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/Section.astro';
---
<MainLayout title="Page not found" description="This page doesn't exist." noindex>
  <Section narrow>
    <div class="prose">
      <span class="kicker">404</span>
      <h1>Sorry, that page isn't here</h1>
      <p class="lead">It may have moved, or the link may have a typo. These might help:</p>
      <ul>
        <li><a href="/">Homepage</a></li>
        <li><a href="/websites/">Websites and pricing</a></li>
        <li><a href="/portfolio/">Portfolio</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </Section>
</MainLayout>
