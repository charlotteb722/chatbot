---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const items = await getCollection('portfolio');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const p = entry.data;
---
<MainLayout title={`${p.name} (${p.demo ? 'demonstration' : 'case study'})`} description={p.summary}>
  <Hero kicker={`${p.demo ? 'Demonstration website' : 'Client project'} · ${p.sector}`} title={p.name} lead={p.summary}>
    <Fragment slot="actions">
      <a class="btn btn-primary" href={p.url}>Open the website</a>
      <a class="btn btn-secondary" href="/portfolio/">All projects</a>
    </Fragment>
  </Hero>
  <Section tone="surface">
    {p.demo && <p class="note" style="margin-bottom:2rem">This is a fictional business, created to show what a website for this kind of business could look like. It isn't a paying client.</p>}
    <div class="grid-2">
      <div class="prose">
        <h2>What the website needs to do</h2>
        <p>{p.goal}.</p>
        <h2>What's on it</h2>
        <ul class="ticks">{p.features.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="card">
        <h3>Colours</h3>
        <div class="swatch-row" aria-hidden="true">{p.colours.map((c) => <span style={`background:${c}`}></span>)}</div>
        <p class="muted">Each demonstration has its own identity, built from the same reusable parts as every site I make.</p>
      </div>
    </div>
  </Section>
  <CtaBand title="Want a website like this?">
    <a class="btn btn-light" href="/contact/#book">Book a free chat</a>
  </CtaBand>
</MainLayout>
