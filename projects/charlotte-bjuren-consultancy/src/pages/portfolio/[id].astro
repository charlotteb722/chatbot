---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const items = await getCollection('portfolio');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const p = entry.data;
---
<MainLayout title={`${p.name} (${p.demo ? 'demonstration' : 'case study'})`} description={p.summary}>
  <Hero kicker={`${p.demo ? 'Demonstration website' : 'Client project'} · ${p.sector}`} title={p.name} lead={p.summary}>
    <Fragment slot="actions">
      <a class="btn btn-primary" href={p.url}>Open the website</a>
      <a class="btn btn-secondary" href="/portfolio/">All projects</a>
    </Fragment>
  </Hero>
  <Section tone="surface">
    {p.demo && <p class="note" style="margin-bottom:2rem">This is a fictional business, created to show what a website for this kind of business could look like. It isn't a paying client.</p>}
    <div class="grid-2">
      <div class="prose">
        <h2>What the website needs to do</h2>
        <p>{p.goal}.</p>
        <h2>What's on it</h2>
        <ul class="ticks">{p.features.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="stack">
      <div class="card">
        <h3>Share this demonstration</h3>
        <p class="muted">Send this link to anyone who'd like to see an example.</p>
        <p><code class="share-url" data-path={p.url} style="word-break:break-all">{p.url}</code></p>
        <div class="actions">
          <button class="btn btn-secondary share-copy" type="button" data-path={p.url}>Copy link</button>
          <a class="btn btn-primary" href={p.url}>Open it</a>
        </div>
        <p class="hint share-status" role="status" aria-live="polite"></p>
      </div>
      <div class="card">
        <h3>Colours</h3>
        <div class="swatch-row" aria-hidden="true">{p.colours.map((c) => <span style={`background:${c}`}></span>)}</div>
        <p class="muted">Each demonstration has its own identity, built from the same reusable parts as every site I make.</p>
      </div>
      </div>
    </div>
  </Section>
  <CtaBand title="Want a website like this?">
    <a class="btn btn-light" href="/contact/#book">Book a free chat</a>
  </CtaBand>
</MainLayout>

<script>
  // Show the full link for whichever address the site is on, and copy it on request.
  document.querySelectorAll<HTMLElement>('.share-url').forEach((el) => { el.textContent = location.origin + el.dataset.path; });
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((btn) => btn.addEventListener('click', async () => {
    const url = location.origin + btn.dataset.path;
    const status = btn.closest('.card')?.querySelector('.share-status');
    try {
      if (navigator.share) { await navigator.share({ title: document.title, url }); return; }
      await navigator.clipboard.writeText(url);
      if (status) status.textContent = 'Link copied.';
    } catch (e) {
      if ((e as Error).name === 'AbortError') return;
      if (status) status.textContent = 'Copy the link shown above.';
    }
  }));
</script>
