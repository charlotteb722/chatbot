---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import Headshot from '../components/Headshot.astro';
import { getSite as getSiteForPhoto } from '../lib/site';
const hasPhoto = !!(await getSiteForPhoto()).headshot;
---
<MainLayout
  title="About Charlotte Bjuren"
  description="Charlotte Bjuren is a Business Analyst in Crieff, Perthshire, who builds websites and helps small businesses use AI and automation in plain English."
>
  <Hero kicker="About" title="Hello, I'm Charlotte" lead="I'm a Business Analyst based in Crieff, Perthshire, working with small businesses throughout the UK. I help them get websites that work and use technology without being overwhelmed by it." />

  <Section id="story" tone="surface">
    <div class:list={[hasPhoto ? 'grid-2' : 'narrow']}>
      <div class="prose">
        <h2>Why I do this</h2>
        <p>I have always been interested in how technology can help people solve everyday problems. With a professional background in business analysis, IT and artificial intelligence, I have seen how the right technology can make a business more efficient and easier to run.</p>
        <p>I started my consultancy because I believe small businesses deserve access to the same digital opportunities as larger organisations, without the expense or complexity.</p>
        <p>Whether you need a new website, help understanding AI or a simpler way to manage your daily administration, my aim is to provide practical, affordable solutions that give you confidence and control.</p>
        <h2>What you can expect from me</h2>
        <ul class="ticks">
          <li>Understand your business before recommending technology.</li>
          <li>Be transparent about prices and ongoing costs.</li>
          <li>Explain technical concepts in everyday language.</li>
          <li>Give you ownership and control of your website.</li>
          <li>Choose solutions that are easy to use and maintain.</li>
          <li>Help you make the most of technology at your own pace.</li>
          <li>Build lasting relationships based on trust and good service.</li>
        </ul>
      </div>
      <Headshot />
    </div>
  </Section>

  <Section id="background" title="My background" narrow>
    <div class="prose">
      <p>I am an experienced Business Analyst and technology professional with a background in psychology, cognitive science, artificial intelligence and computer science.</p>
      <p>Throughout my career, I have worked across different industries, helping organisations understand their requirements, improve business processes and make better use of technology.</p>
      <p>My experience includes website development, data analytics, business automation, Microsoft Power Platform and AI-assisted development.</p>
      <p>Based in Crieff, Perthshire, I bring this experience to small businesses across Scotland and the wider UK, providing personal, practical support tailored to each business.</p>
    </div>
  </Section>

  <Section id="how-i-help" tone="surface" title="How I work with you" narrow>
    <div class="prose">
      <p>Every project starts with a conversation about your business, your customers and what you need them to do. I ask a lot of questions, because the answers decide what the website should say and how it should work.</p>
      <p>After that you get a fixed price, a clear plan and a website you can check before it goes live. I keep you informed in plain English, and I tell you straight away if something would change the cost or the timescale.</p>
    </div>
  </Section>

  <CtaBand title="Let's have a chat" text="Thirty minutes, free, by video or in person around Crieff.">
    <a class="btn btn-light" href="/contact/#talk">Arrange a free consultation</a>
    <a class="btn btn-secondary" style="color:var(--c-on-dark);border-color:var(--c-on-dark)" href="/contact/">Send a message</a>
  </CtaBand>
</MainLayout>
