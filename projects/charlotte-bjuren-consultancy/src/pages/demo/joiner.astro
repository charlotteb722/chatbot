---
import DemoLayout from '../../layouts/DemoLayout.astro';
import Section from '../../components/Section.astro';
import Steps from '../../components/Steps.astro';
import Gallery from '../../components/Gallery.astro';
import FaqList from '../../components/FaqList.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Photo from '../../components/Photo.astro';

// Fictional details. 01632 960 numbers are reserved by Ofcom for drama and examples.
const phone = '01632 960418';
const tel = `tel:${phone.replace(/\s/g, '')}`;
const areas = ['Crieff', 'Comrie', 'Muthill', 'Auchterarder', 'Methven', 'Gilmerton', 'St Fillans', 'Braco'];
const services = [
  { src: 'aj-kitchen-white', alt: 'White painted kitchen with wooden bar stools and brass pendant lights', title: 'Bespoke kitchens', text: 'Designed around your room and how you cook. Made to measure, fitted by the people who built it.' },
  { src: 'aj-side-table', alt: 'Small handmade wooden side table with an open shelf', title: 'Handcrafted furniture', text: 'Tables, shelving and storage in oak, ash and larch, made in our workshop near Crieff.' },
  { src: 'aj-timber-frame', alt: 'Bright timber-framed room with exposed beams and a staircase', title: 'Stairs, doors and timber work', text: 'Staircases, internal doors, panelling and the structural timber work that holds it all together.' },
  { src: 'aj-mitre-saw', alt: 'Joiner cutting timber with a mitre saw in a house being renovated', title: 'Repairs and fitting', text: 'Sticking doors, rotten sills, skirting and the small jobs that never quite get done.' },
];
---
<DemoLayout
  name="Ardvane Joinery"
  tagline="Joinery and furniture makers, Strathearn"
  theme="joiner"
  title="Bespoke kitchens and joinery in Crieff and Strathearn"
  description="Demonstration website for a fictional joinery business."
  home="/demo/joiner/"
  links={[{ href: '#services', label: 'Services' }, { href: '#work', label: 'Our work' }, { href: '#craft', label: 'Workshop' }, { href: '#quote', label: 'Get a quote' }]}
  cta={{ href: tel, label: `Call ${phone}` }}
>
  <section class="photo-hero">
    <div class="bg"><Photo src="aj-oak-kitchen-loch" alt="Oak shaker kitchen with a solid timber island, stone wall and a window looking out over hills and a loch" eager sizes="100vw" widths={[640, 1080, 1440, 1600]} /></div>
    <div class="container">
      <span class="kicker">Strathearn · Fully insured · Free quotes</span>
      <h1>Kitchens and furniture, made properly in Perthshire</h1>
      <p class="lead">Bespoke kitchens, handcrafted furniture and fine joinery for homes across Crieff and Strathearn. Designed with you, made in our workshop, fitted by us.</p>
      <div class="actions">
        <a class="btn btn-light" href="#quote">Ask for a free quote</a>
        <a class="btn btn-ghost-light" href={tel}>Call {phone}</a>
      </div>
    </div>
  </section>

  <Section id="facts" narrow={false}>
    <ul class="facts">
      <li><strong>Made to measure</strong><span class="muted">Every piece built for your room</span></li>
      <li><strong>Local timber</strong><span class="muted">Scottish oak, ash and larch where we can</span></li>
      <li><strong>Fixed quotes</strong><span class="muted">In writing within two days of visiting</span></li>
      <li><strong>Fully insured</strong><span class="muted">Public liability cover as standard</span></li>
    </ul>
  </Section>

  <Section id="services" tone="surface" kicker="What we do" title="Joinery for homes across Strathearn">
    <div class="grid-4">
      {services.map((s) => (
        <article class="photo-card">
          <div class="media"><Photo src={s.src} alt={s.alt} ratio="4 / 3" sizes="(min-width: 1000px) 25vw, (min-width: 640px) 50vw, 100vw" /></div>
          <div class="body"><h3>{s.title}</h3><p class="muted">{s.text}</p><a class="more" href="#quote">Ask about this</a></div>
        </article>
      ))}
    </div>
  </Section>

  <Section id="work" kicker="Our work" title="Recent kitchens and furniture">
    <Gallery items={[
      { src: 'aj-kitchen-blue', alt: 'Kitchen with blue cabinets, marble worktops and wooden floor', caption: 'Blue shaker kitchen, Comrie', size: 'wide' },
      { src: 'aj-vanity', alt: 'Floating wooden vanity unit with open shelves', caption: 'Oak vanity, Crieff', size: 'tall' },
      { src: 'aj-chair', alt: 'Upholstered dining chair with solid wood legs', caption: 'Dining chairs, Muthill' },
      { src: 'aj-kitchen-white', alt: 'White kitchen island with timber stools', caption: 'Island and stools, Auchterarder', size: 'wide' },
      { src: 'aj-kitchen-dark', alt: 'Dark green kitchen with brass handles and light worktops', caption: 'Painted kitchen, Methven' },
    ]} />
    <p class="hint" style="margin-top:.75rem">On a real website these would be the business's own project photos.</p>
  </Section>

  <section class="section section-dark" id="craft" aria-labelledby="craft-title">
    <div class="container split">
      <div class="media"><Photo src="aj-turning" alt="Close-up of hands turning a piece of wood on a lathe with shavings flying" ratio="4 / 5" sizes="(min-width: 800px) 45vw, 100vw" /></div>
      <div class="copy">
        <span class="kicker">The workshop</span>
        <h2 id="craft-title">Built by hand, built to last</h2>
        <p class="lead">Every kitchen and piece of furniture starts in our workshop outside Crieff. We choose the timber, cut the joints and finish everything ourselves, so we know exactly how it's made.</p>
        <div class="media"><Photo src="aj-tools" alt="Wall of hand planes, saws and chisels in a joinery workshop" ratio="16 / 9" sizes="(min-width: 800px) 45vw, 100vw" /></div>
      </div>
    </div>
  </section>

  <Section id="how" kicker="How quotes work" title="Simple, with no surprises">
    <Steps items={[
      { title: 'Tell us about the job', text: 'Use the form or call. A photo or rough sketch helps.' },
      { title: 'We visit and measure', text: 'Usually within a week, at a time that suits you.' },
      { title: 'A fixed written quote', text: 'Within two days of the visit, with drawings for bespoke work.' },
    ]} />
  </Section>

  <Section id="areas" tone="surface" kicker="Where we work" title="Areas we cover">
    <div class="split">
      <div class="copy">
        <p class="lead">Based near Crieff, covering about 15 miles around. For kitchens and larger furniture we travel further.</p>
        <ul class="ticks" style="columns: 2 9rem; display:block">{areas.map((a) => <li style="margin-bottom:.5rem">{a}</li>)}</ul>
      </div>
      <div class="media"><Photo src="aj-measuring" alt="Joiner measuring and marking a length of timber" ratio="16 / 10" sizes="(min-width: 800px) 45vw, 100vw" /></div>
    </div>
  </Section>

  <Section id="faqs" title="Questions" narrow>
    <FaqList items={[
      { q: 'Do you charge for quotes?', a: 'No. Quotes and visits are free and there is no obligation.' },
      { q: 'How long does a bespoke kitchen take?', a: 'Usually eight to twelve weeks from agreeing the design to fitting, depending on the timber and finish.' },
      { q: 'Are you insured?', a: 'Yes, with public liability insurance. We are happy to show the certificate.' },
    ]} />
    <p class="hint" style="margin-top:1rem">Reviews: on a real website, genuine customer reviews or a link to Google reviews would go here. Demonstration sites never show invented reviews.</p>
  </Section>

  <Section id="quote" tone="surface" kicker="Free quote" title="Ask for a quote">
    <div class="grid-2">
      <EnquiryForm mode="demo" formName="joiner-quote" submitLabel="Send quote request" fields={[
        { id: 'name', label: 'Your name', required: true, half: true },
        { id: 'phone', label: 'Phone number', type: 'tel', required: true, half: true },
        { id: 'postcode', label: 'Postcode', required: true, hint: 'So we can check we cover your area', half: true },
        { id: 'job', label: 'Type of job', type: 'select', required: true, options: ['Kitchen', 'Furniture', 'Stairs or doors', 'Repair', 'Something else'], half: true },
        { id: 'details', label: 'Tell us about the job', type: 'textarea', required: true },
      ]} />
      <div class="stack">
        <div class="media"><Photo src="aj-kitchen-oak" alt="Finished kitchen with oak and white cabinetry" ratio="4 / 3" sizes="(min-width: 800px) 40vw, 100vw" /></div>
        <div class="card">
          <h3>Prefer to call?</h3>
          <p><a class="btn btn-primary" href={tel}>Call {phone}</a></p>
          <p class="muted">Monday to Friday, 8am to 5pm. Leave a message and we'll call back the same day.</p>
        </div>
      </div>
    </div>
  </Section>

  <Fragment slot="footer">
    <div><h2>Ardvane Joinery</h2><p>Bespoke kitchens, furniture and joinery across Strathearn.</p></div>
    <div><h2>Contact</h2><p>{phone}<br />hello@ardvane-joinery.example</p></div>
    <div><h2>Hours</h2><p>Monday to Friday, 8am to 5pm</p></div>
  </Fragment>
</DemoLayout>
