---
import DemoLayout from '../../layouts/DemoLayout.astro';
import Section from '../../components/Section.astro';
import Gallery from '../../components/Gallery.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Photo from '../../components/Photo.astro';

// On a client site these lists would live in a data file the owner can edit.
const hours = [
  ['Monday', 'Closed'], ['Tuesday', '8.30am to 4pm'], ['Wednesday', '8.30am to 4pm'], ['Thursday', '8.30am to 4pm'],
  ['Friday', '8.30am to 4pm'], ['Saturday', '8.30am to 5pm'], ['Sunday', '9.30am to 4pm'],
];
const menu = [
  { src: 'lb-loaf', alt: 'Sliced sourdough loaf on a wooden board', section: 'Bread', items: [['Country sourdough', '£4.80'], ['Seeded rye', '£4.50'], ['White bloomer', '£3.20']] },
  { src: 'lb-croissants', alt: 'Two golden croissants dusted with flour', section: 'Pastries', items: [['Butter croissant', '£2.60'], ['Cardamom bun', '£3.20'], ['Pain au chocolat', '£2.90']] },
  { src: 'lb-cake', alt: 'Chocolate layer cake with piped chocolate topping', section: 'Cakes and bakes', items: [['Chocolate fudge cake', '£4.20'], ['Millionaire’s shortbread', '£3.00'], ['Cheese scone', '£2.80']] },
  { src: 'lb-lattes', alt: 'Two hands holding cups of coffee with latte art', section: 'Coffee', items: [['Flat white', '£3.30'], ['Cappuccino', '£3.40'], ['Filter coffee', '£2.90']] },
];
---
<DemoLayout
  name="Larchfield Bakehouse"
  tagline="Artisan bakery and café"
  theme="cafe"
  title="Artisan bakery and café"
  description="Demonstration website for a fictional village bakery and café."
  home="/demo/cafe/"
  links={[{ href: '#menu', label: 'Menu' }, { href: '#hours', label: 'Opening hours' }, { href: '#find', label: 'Find us' }, { href: '#groups', label: 'Groups' }]}
  cta={{ href: '#hours', label: 'Are we open?' }}
>
  <section class="photo-hero">
    <div class="bg"><Photo src="lb-bakery-counter" alt="Café counter with sourdough loaves, croissants, a raspberry sponge and a latte, with sunny tables behind" eager sizes="100vw" widths={[640, 1080, 1440, 1600]} /></div>
    <div class="container">
      <span class="kicker" style="font-family:var(--font-script);font-size:1.6rem;letter-spacing:0;text-transform:none">Baked here every morning</span>
      <h1>Slow-proved bread, proper coffee and a warm seat by the window</h1>
      <p class="lead">A small village bakery and café in the heart of Perthshire. Walkers, dogs and muddy boots welcome.</p>
      <div class="actions">
        <a class="btn btn-primary" href="#menu">See today's menu</a>
        <a class="btn btn-ghost-light" href="#find">How to find us</a>
      </div>
    </div>
  </section>

  <Section id="notice" narrow>
    <p class="note"><strong>Winter hours:</strong> from November to February we close at 3pm on weekdays. Thanks for your patience.</p>
  </Section>

  <Section id="menu" kicker="Menu" title="Fresh from the oven" intro="Everything is baked on site from 5am. When it's gone, it's gone.">
    <div class="menu-grid">
      {menu.map((m) => (
        <article class="photo-card">
          <div class="media"><Photo src={m.src} alt={m.alt} ratio="4 / 3" sizes="(min-width: 1000px) 25vw, (min-width: 560px) 50vw, 100vw" /></div>
          <div class="body">
            <h3>{m.section}</h3>
            <ul class="menu-list">{m.items.map(([n, p]) => <li><span>{n}</span><span>{p}</span></li>)}</ul>
          </div>
        </article>
      ))}
    </div>
    <p class="hint" style="margin-top:1rem">Please tell us about any allergies when you order. Example menu for demonstration only.</p>
  </Section>

  <section class="section section-dark" aria-labelledby="coffee-title">
    <div class="container split reverse">
      <div class="media"><Photo src="lb-pour-over" alt="Barista pouring water over a coffee filter" ratio="4 / 3" sizes="(min-width: 800px) 45vw, 100vw" /></div>
      <div class="copy">
        <span class="kicker">Coffee</span>
        <h2 id="coffee-title">Roasted in Scotland, made with care</h2>
        <p class="lead">Our beans come from a small roaster just down the road. Espresso, filter or a pot of loose-leaf tea, with oat milk at no extra charge.</p>
      </div>
    </div>
  </section>

  <Section id="inside" kicker="Inside" title="Come in and stay a while">
    <Gallery items={[
      { src: 'lb-interior-green', alt: 'Café interior full of plants with wooden tables and hanging lights', caption: 'The garden room', size: 'wide' },
      { src: 'lb-pastry-case', alt: 'Glass counter filled with croissants and pastries', caption: 'The pastry counter', size: 'tall' },
      { src: 'lb-counter', alt: 'Café counter with shelves of jars and pendant lights', caption: 'The bakery counter' },
      { src: 'lb-interior', alt: 'Bright café seating area with mixed chairs and plants', caption: 'Plenty of seats', size: 'wide' },
      { src: 'lb-coffees', alt: 'Two cups of cappuccino on a wooden table beside plants', caption: 'Flat whites' },
    ]} />
  </Section>

  <Section id="hours" tone="surface" kicker="Opening hours" title="When we're open">
    <div class="grid-2">
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">Opening hours</caption>
          <tbody>{hours.map(([d, h]) => <tr><th scope="row">{d}</th><td>{h}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="card" id="find">
        <h3>Find us</h3>
        <p>Main Street, Larchfield, Perthshire (a fictional village).</p>
        <p class="muted">Free parking beside the village hall. Step-free entrance and an accessible toilet.</p>
        <p><strong>Phone:</strong> 01632 960733<br /><strong>Email:</strong> hello@larchfield-bakehouse.example</p>
        <p><a class="btn btn-secondary" href="#find" aria-disabled="true">Get directions (demo)</a></p>
      </div>
    </div>
  </Section>

  <Section id="groups" kicker="Groups and occasions" title="Bringing a group?">
    <div class="grid-2">
      <div class="stack">
        <p class="lead">We can seat walking groups, birthday teas and small gatherings of up to 16. Let us know a few days ahead and we'll have the big table ready.</p>
        <div class="media"><Photo src="lb-cookies" alt="Bowl of chocolate chip cookies on baking paper" ratio="16 / 10" sizes="(min-width: 800px) 45vw, 100vw" /></div>
      </div>
      <EnquiryForm mode="demo" formName="cafe-groups" submitLabel="Send group enquiry" fields={[
        { id: 'name', label: 'Your name', required: true, half: true },
        { id: 'email', label: 'Email address', type: 'email', required: true, half: true },
        { id: 'date', label: 'Date', type: 'date', required: true, half: true },
        { id: 'people', label: 'Number of people', type: 'number', required: true, half: true },
        { id: 'note', label: 'Anything else?', type: 'textarea', hint: 'For example dietary needs or a celebration' },
      ]} />
    </div>
  </Section>

  <Fragment slot="footer">
    <div><h2>Larchfield Bakehouse</h2><p>Main Street, Larchfield, Perthshire</p></div>
    <div><h2>Contact</h2><p>01632 960733<br />hello@larchfield-bakehouse.example</p></div>
    <div><h2>Opening hours</h2><p>Tuesday to Sunday. Closed Mondays.</p></div>
  </Fragment>
</DemoLayout>
