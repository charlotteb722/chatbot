---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/Section.astro';
---
<MainLayout title="Thank you" description="Your enquiry has been sent." noindex>
  <Section narrow>
    <div class="prose">
      <span class="kicker">Message sent</span>
      <h1>Thank you, your enquiry is on its way</h1>
      <p class="lead">I'll reply within two working days. If you don't hear back, please check your spam folder, then try again.</p>
      <div class="actions"><a class="btn btn-primary" href="/">Back to the homepage</a><a class="btn btn-secondary" href="/portfolio/">Look at the portfolio</a></div>
    </div>
  </Section>
</MainLayout>
