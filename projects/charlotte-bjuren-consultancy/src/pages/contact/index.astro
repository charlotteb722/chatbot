---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { getSite, publicEmail, telHref } from '../../lib/site';
import Photo from '../../components/Photo.astro';
const s = await getSite();
const email = publicEmail(s);
---
<MainLayout title="Contact and free consultation" description="Arrange a free 30-minute consultation or send an enquiry to Charlotte Bjuren about a website, website care, AI coaching or automation. Based in Crieff, Perthshire.">
  <Hero kicker="Contact" title="Let's talk about your business" lead="Call me or send an enquiry, and we’ll arrange a free 30-minute consultation at a time that suits you." />

  <section class="section section-surface" id="talk" aria-labelledby="talk-title">
    <div class="container split">
      <div class="copy">
        <span class="kicker">Free consultation</span>
        <h2 id="talk-title">Let’s talk about your business</h2>
        <p class="lead">Arrange a free, no-obligation 30-minute consultation to discuss your website, AI or digital business needs.</p>
        <p>Simply give me a call or send an enquiry using the contact form below. We can arrange a convenient time to speak by phone, video call or in person around Crieff and Perthshire.</p>
        {s.phone && <p class="phone-line">Call me: <a href={telHref(s.phone)}>{s.phone}</a></p>}
        <div class="actions">
          {s.phone && <a class="btn btn-primary" href={telHref(s.phone)}>Call me</a>}
          <a class="btn btn-secondary" href="#enquiry">Send an enquiry</a>
        </div>
      </div>
      <div class="media"><Photo src="cb-planning" alt="Two people talking through plans with laptops and a notepad" ratio="4 / 3" sizes="(min-width: 800px) 45vw, 100vw" /></div>
    </div>
  </section>

  <Section id="enquiry" kicker="Send a message" title="Send an enquiry or ask for a quote">
    <div class="grid-2">
      <EnquiryForm
        mode="live"
        formName="enquiry"
        submitLabel="Send my enquiry"
        fields={[
          { id: 'name', label: 'Your name', required: true, autocomplete: 'name', half: true },
          { id: 'email', label: 'Email address', type: 'email', required: true, autocomplete: 'email', half: true },
          { id: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel', hint: 'Optional. Only if you would like a call back.', half: true },
          { id: 'business', label: 'Business name', autocomplete: 'organization', hint: 'Optional', half: true },
          { id: 'type', label: 'What can I help with?', type: 'select', required: true, options: ['A new website (not sure which package)', 'Website Essentials', 'Business Website', 'Business Website Plus', 'Redesign of an existing website', 'Website care', 'AI coaching', 'Automation', 'Digital business support', 'Something else'] },
          { id: 'chat', label: 'Would you like a free 30-minute consultation?', type: 'select', options: ['Yes, by phone', 'Yes, by video call', 'Yes, in person near Crieff', 'No, just reply by email'] },
          { id: 'website', label: 'Current website, if you have one', hint: 'For example www.yourbusiness.co.uk', half: true },
          { id: 'budget', label: 'Rough budget', type: 'select', options: ['Under £500', '£500 to £1,000', '£1,000 to £1,500', 'Over £1,500', 'Not sure yet'], half: true },
          { id: 'message', label: 'Tell me a little about your business and what you need', type: 'textarea', required: true },
        ]}
      />
      <aside class="stack" aria-label="Other ways to get in touch">
        <div class="card">
          <h3>Other ways to get in touch</h3>
          {email && <p><strong>Email:</strong> <a href={`mailto:${email}`}>{email}</a></p>}
          {s.phone && <p><strong>Phone:</strong> <a href={telHref(s.phone)}>{s.phone}</a></p>}
          <p><strong>Based in:</strong> {s.location}</p>
          <p><strong>Areas:</strong> {s.areas}</p>
          <p><strong>When:</strong> {s.hours}</p>
        </div>
        <div class="card">
          <h3>What happens next</h3>
          <p class="muted">I read every enquiry myself and reply within two working days. If a consultation would help, I'll suggest a few times. Your details are only used to reply to you.</p>
        </div>
      </aside>
    </div>
  </Section>
</MainLayout>
