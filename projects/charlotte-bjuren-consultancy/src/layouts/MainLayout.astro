---
// Layout for Charlotte Bjuren's own website pages.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getSite, publicEmail, telHref } from '../lib/site';

interface Props { title: string; description: string; jsonLd?: object; noindex?: boolean }
const { title, description, jsonLd, noindex } = Astro.props;
const s = await getSite();
const links = [
  { href: '/websites/', label: 'Websites & pricing' },
  { href: '/ai-and-automation/', label: 'AI & automation' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/about/', label: 'About' },
  { href: '/faqs/', label: 'FAQs' },
  { href: '/contact/', label: 'Contact' },
];
const year = new Date().getFullYear();
const email = publicEmail(s);
---
<BaseLayout title={title} description={description} theme="strathearn" siteName={s.name} jsonLd={jsonLd} noindex={noindex}>
  <SiteHeader slot="header" brand={s.name} sub={s.descriptor} links={links} cta={{ href: '/contact/#talk', label: 'Arrange a free consultation' }} />
  <slot />
  <footer slot="footer" class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div>
          <p class="footer-brand">{s.name}</p>
          <p class="footer-line">{s.location}. Working with customers throughout the UK.</p>
        </div>
        <div class="actions">
          {s.phone && <a class="btn btn-light" href={telHref(s.phone)}>Call {s.phone}</a>}
          <a class="btn btn-ghost-light" href="/contact/#enquiry">Send an enquiry</a>
        </div>
      </div>
      <div class="footer-grid">
        <nav aria-label="Services">
          <h2>Services</h2>
          <ul>
            <li><a href="/websites/">Websites and pricing</a></li>
            <li><a href="/websites/#care">Website care</a></li>
            <li><a href="/ai-and-automation/">AI and automation</a></li>
            <li><a href="/portfolio/">Portfolio</a></li>
          </ul>
        </nav>
        <nav aria-label="Contact">
          <h2>Contact</h2>
          <ul>
            <li><a href="/contact/#enquiry">Send an enquiry</a></li>
            <li><a href="/contact/#talk">Arrange a free consultation</a></li>
            {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
            {s.phone && <li><a href={telHref(s.phone)}>Call {s.phone}</a></li>}
            {s.linkedin && <li><a href={s.linkedin} rel="me">LinkedIn</a></li>}
            <li><a href="/faqs/">FAQs</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal and accessibility">
          <h2>Legal and accessibility</h2>
          <ul>
            <li><a href="/privacy/">Privacy notice</a></li>
            <li><a href="/terms/">Business terms</a></li>
            <li><a href="/accessibility/">Accessibility</a></li>
          </ul>
        </nav>
      </div>
      <div class="footer-base">
        <p>© <span data-year>{year}</span> {s.name}, sole trader.</p>
        <p>No cookies. No tracking.</p>
      </div>
    </div>
    <script>
      // Keep the copyright year current between rebuilds.
      document.querySelectorAll('[data-year]').forEach((el) => { el.textContent = String(new Date().getFullYear()); });
    </script>
  </footer>
</BaseLayout>
